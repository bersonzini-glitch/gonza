## Public Supabase project settings (safe to expose to the browser).
## Find these in your Supabase project: Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

## Server-only. NEVER expose this to the browser, logs, or version control.
## Settings -> API -> Project API keys -> service_role.
SUPABASE_SERVICE_ROLE_KEY=

## Used once by `npm run setup:admin` to provision the first administrator
## account. Not read anywhere else, and never exposed to the client.
INITIAL_ADMIN_USERNAME=
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

## Optional. The canonical public URL of your deployment, used for
## sitemap.xml, robots.txt, and Open Graph metadata. Defaults to
## http://localhost:3000 in development.
NEXT_PUBLIC_SITE_URL=

## Server-only. Powers the "Buscar eventos con IA" button in the admin
## events panel (src/lib/ai/event-search.ts) — an Anthropic API key with
## web search enabled. Get one at https://console.anthropic.com/settings/keys.
## Without it, the button shows an error instead of running a search.
ANTHROPIC_API_KEY=

## Server-only. Powers the /contact form (src/lib/actions/contact.ts) via
## Resend. Get a key at https://resend.com/api-keys. Without it, the form
## shows an error instead of sending.
RESEND_API_KEY=

## Server-only. The inbox that receives /contact form submissions.
CONTACT_FORM_TO_EMAIL=

## Optional, but recommended. Cloudflare Turnstile CAPTCHA on the /contact
## form, to block bot spam. Create a free widget at
## https://dash.cloudflare.com/?to=/:account/turnstile — the site key is
## public (safe in the browser), the secret key is server-only. Without
## both set, the form has no CAPTCHA widget and accepts submissions with
## only IP rate limiting as protection.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
